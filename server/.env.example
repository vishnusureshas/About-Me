MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/my-profile
PORT=5000
FRONTEND_URL=http://localhost:3000

# Redis — caching + sessions (Upstash, Redis Cloud, or local redis://localhost:6379)
# Leave empty to use in-memory fallback (dev). For prod: redis://:password@host:6379 or rediss://...
REDIS_URL=
SESSION_SECRET=change-this-to-a-strong-random-string-at-least-32-chars

# Optional: override TTLs
# CACHE_CONTACTS_TTL=60
# RATE_LIMIT_WINDOW_SECONDS=900
# RATE_LIMIT_MAX=5

# Realtime Gmail notification (contact form -> your inbox)
# SMTP_USER = your Gmail address, SMTP_APP_PASSWORD = 16-char App Password (not login password)
SMTP_USER=vishnuasuresh2000@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_TO=vishnuasuresh2000@gmail.com
